#!/bin/bash
# Homebox 生命周期主脚本：启停与状态检查
PID_FILE="${TRIM_PKGVAR}/homebox.pid"
LOG_FILE="${TRIM_PKGVAR}/homebox.log"
BIN="${TRIM_APPDEST}/homebox"
PORT="${TRIM_SERVICE_PORT:-3300}"

is_running() {
    [ -f "$PID_FILE" ] || return 1
    local pid
    pid=$(cat "$PID_FILE" | tr -d '[:space:]')
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

case $1 in
    start)
        if is_running; then
            exit 0
        fi
        if [ ! -x "$BIN" ]; then
            echo "homebox 可执行文件不存在或不可执行: $BIN" > "${TRIM_TEMP_LOGFILE}"
            exit 1
        fi
        # 先确保旧日志可写
        : > "$LOG_FILE" 2>/dev/null || true
        nohup "$BIN" serve --host 0.0.0.0 --port "$PORT" >> "$LOG_FILE" 2>&1 &
        echo $! > "$PID_FILE"
        sleep 1
        if is_running; then
            exit 0
        else
            echo "homebox 启动失败，请查看日志: $LOG_FILE" > "${TRIM_TEMP_LOGFILE}"
            rm -f "$PID_FILE"
            exit 1
        fi
        ;;
    stop)
        if is_running; then
            local pid
            pid=$(cat "$PID_FILE" | tr -d '[:space:]')
            kill "$pid" 2>/dev/null
            # 等待进程退出
            for _ in 1 2 3 4 5; do
                kill -0 "$pid" 2>/dev/null || break
                sleep 1
            done
            kill -9 "$pid" 2>/dev/null
        fi
        rm -f "$PID_FILE"
        exit 0
        ;;
    status)
        if is_running; then
            exit 0
        fi
        rm -f "$PID_FILE"
        exit 3
        ;;
    *)
        exit 1
        ;;
esac
